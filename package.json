{
  "name": "podcast-checker",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "vite build",
    "build:netlify": "pnpm build",
    "check": "pnpm lint && pnpm format:check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:pull": "drizzle-kit pull",
    "db:push": "drizzle-kit push",
    "db:setup": "docker compose -f docker-compose.dev.yml up -d --wait postgres && pnpm db:migrate",
    "db:studio": "drizzle-kit studio",
    "dev": "vite dev --port 3000",
    "dev:netlify": "pnpm dev",
    "ingest:once": "tsx --tsconfig tsconfig.scripts.json scripts/ingest-once.ts",
    "intent": "node ./node_modules/@tanstack/intent/dist/cli.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "generate-routes": "tsr generate",
    "icons:generate": "node scripts/generate-icons.mjs",
    "lint": "oxlint . && pnpm lint:deprecations",
    "lint:deprecations": "oxlint --type-aware --config .oxlintrc.deprecations.json .",
    "lint:fix": "oxlint --fix .",
    "lint:staged": "lint-staged --concurrent false",
    "prepare": "husky",
    "preview": "vite preview",
    "test": "vitest run",
    "test:follows": "PODCAST_TEST_CONTAINERS=true vitest run src/lib/podcast-follows.integration.test.ts",
    "test:search": "PODCAST_TEST_CONTAINERS=true vitest run src/lib/episode-query.integration.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@sentry/tanstackstart-react": "^11.11.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/ai": "0.70.0",
    "@tanstack/ai-anthropic": "0.22.1",
    "@tanstack/ai-client": "0.40.0",
    "@tanstack/ai-gemini": "0.38.1",
    "@tanstack/ai-ollama": "0.12.1",
    "@tanstack/ai-openai": "0.30.1",
    "@tanstack/ai-openrouter": "0.23.0",
    "@tanstack/ai-react": "0.31.0",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-query": "5.105.3",
    "@tanstack/react-query-devtools": "5.105.3",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/react-store": "0.11.2",
    "@tanstack/redact": "0.3.1",
    "@tanstack/store": "0.11.2",
    "better-auth": "^1.7.16",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.12.0",
    "fast-xml-validator": "^1.4.2",
    "highlight.js": "^11.11.1",
    "html-to-text": "^10.0.1",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.68.0",
    "pg": "^8.16.3",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^3.1.0",
    "@netlify/functions": "^6.1.0",
    "@netlify/vite-plugin-tanstack-start": "^1.3.19",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.3.0",
    "@tanstack/devtools-event-client": "0.5.1",
    "@tanstack/devtools-vite": "0.8.6",
    "@tanstack/intent": "^0.5.6",
    "@tanstack/router-cli": "^1.167.46",
    "@testcontainers/postgresql": "^12.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.2.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^18.0.9",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "sharp": "^0.35.5",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": "oxlint --fix --no-error-on-unmatched-pattern",
    "*": "oxfmt --write --no-error-on-unmatched-pattern"
  },
  "intent": {
    "skills": [
      "*"
    ]
  }
}
