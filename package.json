    "@tanstack/ai-gemini": "0.34.2",
    "@tanstack/ai-ollama": "0.11.12",
    "@tanstack/ai-openai": "0.26.0",
    "@tanstack/ai-react": "0.29.4",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-query-devtools": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.60",
    "@tanstack/react-store": "0.11.2",
    "@tanstack/store": "0.11.2",
    "better-auth": "^1.5.3",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.577.0",
    "nitro": "3.0.260610-beta",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "streamdown": "^2.3.0",
